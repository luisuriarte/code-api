# Origen Salud Web - Apache
# El DocumentRoot del virtual host debe apuntar a /web.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Defensa en profundidad: el código ya vive fuera del DocumentRoot.
    RewriteRule ^(?:includes|translations)(?:/|$) - [F,L]

    # Rutas legacy todavía no migradas al router.
    RewriteRule ^docs/?$ docs.php [L,QSA]
    RewriteRule ^uvr/?$ uvr.php [L,QSA]
    RewriteRule ^search/?$ search.php [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

    # El portal privado de clientes tiene su propio front controller y su
    # .htaccess interno. Se excluye del catch-all para que no sea capturado
    # por el router del portal público.
    RewriteRule ^portal-clientes(?:/|$) - [L]

    # Resto de solicitudes → front controller del portal.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
