# Origen Salud Web - Apache
# El DocumentRoot del virtual host debe apuntar a /web.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Las traducciones y los includes no se sirven por HTTP.
    RewriteRule ^(?:includes|translations)(?:/|$) - [F,L]

    # Enrutamiento de documentación
    RewriteRule ^docs/?$ docs.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
