+            . " ORDER BY (ver.language_code = 'es-AR') DESC, ver.id DESC"
+            . ' LIMIT 1'
+            . ' ) latest ON TRUE'
+            . ' WHERE i.id = :id'
+            . ' LIMIT 1',
+            [':id' => $id]
+        );
+    }
+
