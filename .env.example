# ==========================================================
# Origen Salud - Configuración de entorno
# Copiar este archivo como .env y completar los valores reales.
# Nunca versionar el archivo .env.
# ==========================================================

APP_NAME="Origen Salud"
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ----------------------------------------------------------
# PostgreSQL 18
# Requiere la extensión pg_trgm (ver sql/design.sql).
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=origen_salud
DB_USER=origen_api
DB_PASSWORD=cambiar_esta_clave
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000

# Umbral de similitud de trigramas (0.05 - 0.95).
# Un valor más bajo devuelve más coincidencias difusas.
DB_TRGM_THRESHOLD=0.25

# ----------------------------------------------------------
# API
# ----------------------------------------------------------
# Default de Fase 8. "es" es alias de es-AR (D-27); es-MX NO es alias (D-39).
# Se usa cuando no hay lang/Accept-Language aceptable o todas las entradas son q=0.
API_DEFAULT_LANG=es
API_PAGE_LIMIT_MAX=50
API_CORS_ORIGINS=https://med.origen.ar

# ----------------------------------------------------------
# Portal web
# ----------------------------------------------------------
WEB_DEFAULT_LOCALE=es-AR
WEB_BASE_URL=https://med.origen.ar

# ----------------------------------------------------------
# Portal web - acceso directo a PostgreSQL (solo lectura)
# Rol previsto: origen_med (creado por el administrador del VPS).
# ----------------------------------------------------------
PORTAL_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=origen_codes
PORTAL_DB_USER=origen_med
PORTAL_DB_PASS=
PORTAL_DB_STATEMENT_TIMEOUT=3

# ----------------------------------------------------------
# Portal web - Invoice Ninja v5 (gestion.uriarte.ar)
# Solo lectura. El token debe ser de PRUEBA: nunca pegar el token real.
# INVOICE_NINJA_ALLOW_TEST_CALLS debe ser true para habilitar consultas HTTP.
# ----------------------------------------------------------
INVOICE_NINJA_BASE_URL=https://gestion.uriarte.ar
INVOICE_NINJA_API_PREFIX=/api/v1
INVOICE_NINJA_API_TOKEN=
INVOICE_NINJA_ALLOW_TEST_CALLS=false
INVOICE_NINJA_TIMEOUT=8
INVOICE_NINJA_RETRIES=1
INVOICE_NINJA_CATALOG_LIMIT=100

# ----------------------------------------------------------
# Portal web - OpenWA (open-wa / wa-automate v5, Easy API)
# El id de sesión NO reemplaza a la clave API.
# ----------------------------------------------------------
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_TIMEOUT=10
WHATSAPP_NOTIFY_TO=

# ----------------------------------------------------------
# Portal web - SMTP del formulario de contacto
# ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente del sobre. Si se deja vacío se usa SMTP_USER; algunos MTA
# (reject_sender_login_mismatch) rechazan un remitente distinto del usuario SMTP.
SMTP_FROM=
CONTACT_EMAIL=med@origen.ar
# Copias ocultas del formulario de contacto y de la Solicitud de Servicios.
# Varias direcciones separadas por , o ;. Si está vacío no se envían copias.
# REPLY_TO se acepta como alias.
CONTACT_BCC=
REPLY_TO=
CONTACT_NAME=Origen Salud

# ----------------------------------------------------------
# Portal web - límites de frecuencia
# ----------------------------------------------------------
RATE_CONTACT=5
# Límite de envíos de la Solicitud de Servicios (antes RATE_CART).
RATE_REQUEST=5
RATE_BROWSE=120
RATE_WINDOW=3600

# ----------------------------------------------------------
# Fase 1 / M1 - Administración y gobernanza (esquema os_admin)
# El rol origen_admin NO debe tener permisos sobre os_catalog_*.
# La migración sql/09_admin/fase1_identidad.sql NO se ejecuta automáticamente.
# ----------------------------------------------------------
PORTAL_ADMIN_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=origen_codes
PORTAL_ADMIN_DB_USER=origen_admin
PORTAL_ADMIN_DB_PASS=
PORTAL_ADMIN_DB_STATEMENT_TIMEOUT=3

# Secreto pepper para hashes de contraseña. Debe ser largo, aleatorio y estable.
# Cambiarlo invalida todas las contraseñas: mantenerlo en el gestor de secretos.
ADMIN_PASSWORD_PEPPER=

ADMIN_SESSION_LIFETIME=43200
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW=900
ADMIN_LOCK_MINUTES=15
ADMIN_RESET_TTL=3600
ADMIN_REQUIRE_HTTPS=true

# ----------------------------------------------------------
# Fase 2 / M2 - Gobernanza (organizaciones e invitaciones)
# ----------------------------------------------------------
# Host del panel para los vínculos de invitación y reset.
# Si se deja vacío se usa WEB_BASE_URL. NUNCA se usa el Host de la petición.
ADMIN_BASE_URL=https://med.origen.ar

# Invitaciones: 7 días por defecto, tope 30 días, reenvío mínimo cada 5 min.
ADMIN_INVITE_TTL=604800
ADMIN_INVITE_MAX_TTL=2592000
ADMIN_INVITE_RESEND_MIN=300

# Portal de Clientes
PORTAL_CUSTOMER_BASE_URL=https://med.origen.ar/portal-clientes
PORTAL_CUSTOMER_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=origen_codes_portal_clientes_test
PORTAL_CUSTOMER_DB_USER=origen_customer
PORTAL_CUSTOMER_DB_PASS=S4nC4rl0sC3ntr0
PORTAL_CUSTOMER_PASSWORD_PEPPER=...
PORTAL_CUSTOMER_TOKEN_PEPPER=...
PORTAL_CUSTOMER_CREDENTIAL_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=origen_codes
PORTAL_CUSTOMER_CREDENTIAL_DB_USER=origen_admin
PORTAL_CUSTOMER_CREDENTIAL_DB_PASS=S4nC4rl0sC3ntr0
PORTAL_CUSTOMER_CREDENTIAL_DB_STATEMENT_TIMEOUT=3
#PORTAL_CUSTOMER_API_TEST_KEY=654cbd07514c2844eb8f7f6d7d0ee4b9042a40c8bd1b8e8b90ffdce04a4500ee

# ----------------------------------------------------------
# Portal de clientes - Etapa 9 (solo interfaz)
# URL https del portal nativo de facturación. Vacío => la vista
# informa que el enlace no está configurado. Nunca tokens aquí.
# ----------------------------------------------------------
PORTAL_CUSTOMER_BILLING_URL=
