# ==========================================================
# Origen Salud - Configuración de entorno
# Copiar este archivo como .env y completar los valores reales.
# Nunca versionar el archivo .env.
# ==========================================================

APP_NAME="Origen Salud"
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ----------------------------------------------------------
# PostgreSQL 18
# Requiere la extensión pg_trgm (ver sql/design.sql).
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=origen_salud
DB_USER=origen_api
DB_PASSWORD=cambiar_esta_clave
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000

# Umbral de similitud de trigramas (0.05 - 0.95).
# Un valor más bajo devuelve más coincidencias difusas.
DB_TRGM_THRESHOLD=0.25

# ----------------------------------------------------------
# API
# ----------------------------------------------------------
# Default de Fase 8. "es" es alias de es-AR (D-27); es-MX NO es alias (D-39).
# Se usa cuando no hay lang/Accept-Language aceptable o todas las entradas son q=0.
API_DEFAULT_LANG=es
API_PAGE_LIMIT_MAX=50
API_CORS_ORIGINS=https://med.origen.ar

# ----------------------------------------------------------
# Portal web
# ----------------------------------------------------------
WEB_DEFAULT_LOCALE=es
WEB_BASE_URL=https://med.origen.ar
